# Install as /usr/share/libalpm/hooks/zz-ai-antivirus-post.hook
# After every transaction: the packages that changed are read into AI Antivirus's trust cache, so the files an upgrade
# replaced are trusted again at once and legitimate `pacman -Syu` runs do not look like tampering.
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = AI Antivirus: refreshing the trust cache for the changed packages
When = PostTransaction
NeedsTargets
Exec = /usr/lib/ai-antivirus/pacman-post
