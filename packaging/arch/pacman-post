#!/bin/sh
# Install as /usr/lib/synapse/pacman-post (mode 0755). Called by zz-synapse-post.hook with the package names on stdin.
# Runs the refresh as the unprivileged `synapse` user (it owns the database) and never fails the transaction.
db=/var/lib/synapse/synapse.db
if [ -f "$db" ] && id synapse >/dev/null 2>&1 && command -v runuser >/dev/null 2>&1; then
    runuser -u synapse -- /usr/bin/synapsectl pacman-end || echo "synapse: trust cache not refreshed (run: synapsectl trust-baseline)" >&2
else
    cat >/dev/null
fi
exit 0
