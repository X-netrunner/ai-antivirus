# Install scriptlet for synapse-edr. Nothing is enabled or started: Synapse ships in alert-only mode and turning it on is your decision.

post_install() {
    systemd-sysusers synapse.conf >/dev/null 2>&1 || true
    systemd-tmpfiles --create synapse.conf >/dev/null 2>&1 || true
    cat <<'MSG'

  Synapse is installed but not running. To start it (alert-only: it records, notifies, and acts on nothing):

    sudo systemctl enable --now synapse-sensord synapse-engined
    sudo -u synapse synapsectl trust-baseline        # what pacman installed -> trust cache
    synapsectl alerts                                # what it found

  Later, optionally: synapse-responderd (acts on alerts, needs mode = 'contain' or 'enforce' in /etc/synapse/synapse.toml)
  and synapse-ai (needs a local Ollama model and [ai] enabled = true). See /usr/share/doc/synapse-edr/README.md.

MSG
}

post_upgrade() {
    systemd-sysusers synapse.conf >/dev/null 2>&1 || true
    systemd-tmpfiles --create synapse.conf >/dev/null 2>&1 || true
    echo "  Synapse upgraded: restart the services that run (systemctl restart synapse-sensord synapse-engined ...). If you sign your rules, sign them again after the shipped rules changed: synapsectl rules-sign --key KEY"
}

pre_remove() {
    for s in synapse-ai synapse-responderd synapse-engined synapse-sensord; do
        systemctl disable --now "$s.service" >/dev/null 2>&1 || true
    done
}

post_remove() {
    echo "  Synapse's data stays in /var/lib/synapse, /var/lib/synapse-ai and /var/log/synapse (quarantined files included). Remove them yourself when you are sure."
}
