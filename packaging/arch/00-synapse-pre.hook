# Install as /usr/share/libalpm/hooks/00-synapse-pre.hook
# Before every transaction: Synapse confirms it stays passive while pacman holds /var/lib/pacman/db.lck.
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Synapse: pacman transaction starting (no destructive action until it ends)
When = PreTransaction
Exec = /usr/bin/synapsectl pacman-begin
