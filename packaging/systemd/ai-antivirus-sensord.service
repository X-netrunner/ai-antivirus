# Install as /usr/lib/systemd/system/ai-antivirus-sensord.service
#
# M2 sensor daemon: eBPF process/network sensor (with /proc polling as fallback)
# + fanotify file-write sensor -> events.jsonl.
#
# The eBPF object must exist at /usr/lib/ai-antivirus/ai-antivirus-ebpf.o, owned by root
# and not writable by group or others (the sensor refuses it otherwise).
#
# No PrivateTmp=: fanotify marks the filesystem that contains each configured
# path, and a private /tmp would hide the real one from the mark.

[Unit]
Description=AI Antivirus sensor daemon
After=local-fs.target
ConditionPathExists=/etc/ai-antivirus/ai-antivirus.toml

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30
TimeoutStartSec=90
ExecStart=/usr/bin/ai-antivirus-sensord --config /etc/ai-antivirus/ai-antivirus.toml
Restart=always
RestartSec=2
User=root
UMask=0027

# fanotify needs CAP_SYS_ADMIN. Loading eBPF programs needs CAP_BPF, and
# attaching them to tracepoints and kprobes needs CAP_PERFMON. Reading
# /proc/<pid>/exe and /proc/<pid>/cwd of other users' processes still needs
# CAP_SYS_PTRACE even with eBPF (the kernel programs do not report the resolved
# executable path or the working directory; see README, M2 decisions).
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_BPF CAP_PERFMON CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/log/ai-antivirus
ProtectHome=read-only
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Traced under strace while every sensor feature ran: all of its syscalls are in @system-service except these four.
SystemCallFilter=@system-service bpf perf_event_open fanotify_init fanotify_mark
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
