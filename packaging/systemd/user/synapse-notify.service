# Install as /usr/lib/systemd/user/synapse-notify.service, then as your user:
#   sudo usermod -aG synapse-notify "$USER"     # log out and in once
#   systemctl --user enable --now synapse-notify
#
# Shows the responder's notifications (alerts, what was done, what waits for approval) with notify-send (libnotify).

[Unit]
Description=Synapse EDR desktop notifications
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/synapse-notify
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateNetwork=yes

[Install]
WantedBy=graphical-session.target
