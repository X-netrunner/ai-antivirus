# Install as /usr/lib/systemd/system/synapse-ai.service
#
# M5 AI analyzer: reads alert bundles from /var/lib/synapse-ai/spool, asks the local Ollama, leaves the raw answer in
# /var/lib/synapse-ai/out. Advice only. It cannot see the database or the event log (they are not in its folder and it
# is not in their groups), runs no commands, and can only talk to localhost.
# Enable only after setting [ai] enabled = true and a real model in /etc/synapse/synapse.toml.

[Unit]
Description=Synapse EDR AI analyzer (advice only)
After=local-fs.target
ConditionPathExists=/etc/synapse/synapse.toml

[Service]
Type=simple
ExecStart=/usr/bin/synapse-ai --config /etc/synapse/synapse.toml
Restart=on-failure
RestartSec=10
User=synapse-ai
Group=synapse-ai
UMask=0007

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadOnlyPaths=/var/lib/synapse-ai/spool
ReadWritePaths=/var/lib/synapse-ai/out
InaccessiblePaths=/var/lib/synapse /var/lib/synapse-private /var/log/synapse /run/synapse /home /root
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
